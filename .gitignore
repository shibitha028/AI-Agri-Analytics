# Dependencies
**/node_modules/

# Environment variables (never commit real secrets)
**/.env
**/.env.local
**/.env.*.local

# Build output
client/dist/
client/build/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploaded files (runtime data, not source)
server/uploads/*
!server/uploads/.gitkeep

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Package manager locks (optional - remove this if you want to commit lockfiles)
# package-lock.json
# yarn.lock
